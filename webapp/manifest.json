{
  "_version": "1.60.0",
  "sap.app": {
    "id": "code2.fiori.pou.pou1project",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "02ce0597-dbd7-4128-b8b2-edea3a1a608b"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.52",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "code2.fiori.pou.pou1project.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "fade",
        "type": "View",
        "viewType": "XML",
        "path": "code2.fiori.pou.pou1project.view",
        "async": true,
        "viewPath": "code2.fiori.pou.pou1project.view"
      },
      "routes": [
        {
          "name": "Main",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "Dashboard",
          "pattern": "Dashboard",
          "target": [
            "TargetDashboard"
          ]
        },
        {
          "name": "Store",
          "pattern": "Store",
          "target": [
            "TargetStore"
          ]
        },
        {
          "name": "Menu",
          "pattern": "Menu",
          "target": [
            "TargetMenu"
          ]
        },
        {
          "name": "Sales",
          "pattern": "Sales",
          "target": [
            "TargetSales"
          ]
        },
        {
          "name": "Stock",
          "pattern": "Stock",
          "target": [
            "TargetStock"
          ]
        },
        {
          "name": "StockShortage",
          "pattern": "StockShortage",
          "target": [
            "TargetStockShortage"
          ]
        },
        {
          "name": "Purchase",
          "pattern": "Purchase",
          "target": [
            "TargetPurchase"
          ]
        },
        {
          "name": "SalesAnalytics",
          "pattern": "SalesAnalytics",
          "target": [
            "TargetSalesAnalytics"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetDashboard": {
          "id": "Dashboard",
          "name": "Dashboard"
        },
        "TargetStore": {
          "id": "Store",
          "name": "Store"
        },
        "TargetMenu": {
          "id": "Menu",
          "name": "Menu"
        },
        "TargetSales": {
          "id": "Sales",
          "name": "Sales"
        },
        "TargetStock": {
          "id": "Stock",
          "name": "Stock"
        },
        "TargetStockShortage": {
          "id": "StockShortage",
          "name": "StockShortage"
        },
        "TargetPurchase": {
          "id": "Purchase",
          "name": "Purchase"
        },
        "TargetSalesAnalytics": {
          "id": "SalesAnalytics",
          "name": "SalesAnalytics"
        }
      }
    },
    "rootView": {
      "viewName": "code2.fiori.pou.pou1project.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}