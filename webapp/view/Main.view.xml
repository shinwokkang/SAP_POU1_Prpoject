<mvc:View 
    controllerName="code2.fiori.pou.pou1project.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" showHeader="false" enableScrolling="false">
        <content>
            <!-- 화면 중앙 정렬 및 여백 제어 -->
            <FlexBox 
                alignItems="Center" 
                justifyContent="Center" 
                fitContainer="true" 
                height="100%"
                class="sapUiSmallMargin">
                <items>
                    <!-- 화면 높이(vh) 기준으로 반응형 크기 조절 -->
                    <Image 
                        src="/img/MainView_img.png" 
                        height="65vh"
                        decorative="true"
                        densityAware="false" />
                </items>
            </FlexBox>
        </content>
    </Page>
</mvc:View>