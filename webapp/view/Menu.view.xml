<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Menu"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">
    <Page id="Menu_page" title="{i18n>title}">
        <VBox>
                <Title text="메뉴 관리" titleStyle="H3"/>
                <Text text="메뉴 정보, 가격 및 카테고리 조회"/>
        </VBox>
        <t:Table
            id="IMenu"
            rows="{CSET>/MenuSet}"
            selectionMode="MultiToggle"
            selectionBehavior="Row"
            paste="onPaste"
            ariaLabelledBy="title">
            <t:extension>
                <OverflowToolbar style="Clear">
                    <Label text="메뉴명" design="Bold"/>
                    <Input id="IMenuname" width="8em" placeholder="메뉴명 입력"/> 
                    <ToolbarSpacer width = "3rem" /> 
                    <Label text="카테고리" design="Bold"/>
                    <ComboBox id="ICategory" width="14rem" placeholder="카테고리"
                              items="{path : 'Category>/'}">
                    <core:Item key="{Category>Category}" text="{Category>Category}"/>
                    </ComboBox>
                    <ToolbarSpacer width = "3rem" />

                    <Button text="조회" icon="sap-icon://search" press="onSearch"/>

                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column width="11rem">
                    <Label text="메뉴코드" />
                    <t:template>
                        <Text text="{CSET>Menuid}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="11rem">
                    <Label text="메뉴명" />
                    <t:template>
                        <Text text="{CSET>Menuname}" wrapping="false" /> 
                    </t:template>
                </t:Column>
                <t:Column width="11rem">
                    <Label text="카테고리" />
                    <t:template>
                        <Text text="{CSET>Category}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="11rem">
                    <Label text="가격(원)" />
                    <t:template>
                        <Text text="{CSET>Price}" wrapping="false" />
                    </t:template>
                </t:Column>
            </t:columns>					
        </t:Table>

    </Page>
</mvc:View>