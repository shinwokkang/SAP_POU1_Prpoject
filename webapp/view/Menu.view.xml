<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Menu"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">
    <Page id="Menu_page" title="{i18n>title}" showHeader= "false">

<!-- < 메뉴 관리 테이블 /> -->
    <VBox class="sapUiSmallMargin">
        <HBox alignItems = "Center" 
            class="sapUiResponsiveMargin">

            <core:Icon src="sap-icon://menu"
                    size="2rem"
                    color="#0a6ed1"
                    class="sapUiSmallMarginEnd"/>
            
            <VBox width="30em">
                <Title text="메뉴 관리" titleStyle="H3"/>
                <Text text="전국 카페 지점의 현재 발주상태를 관리합니다"/>
            </VBox>


            <HBox>
    
                <ToolbarSpacer width="20rem"/>
                <Title text="총 메뉴 수 : " width="6rem" />

                <Label
                    id="TotalMenuQuantity" design="Bold" width="8rem"
                    text="12"/> 

            </HBox>
        </HBox>
    </VBox>



            <Panel class="sapUiResponsiveMargin" width="auto">
                <HBox alignItems="End">
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="메뉴명" labelFor="iMenuName"/>
                    <Input  id="IInputMenuname" 
                            class="MEDIUM" placeholder="지점명 입력" showClearIcon="true"/>
                </VBox>

                <VBox class="sapUiSmallMarginEnd">
                    <Label text="카테고리" labelFor="iCategory"/>
                    <ComboBox id="ICategory" items="{path : 'Category>/'}" class="MEDIUM" 
                                                                           placeholder="카테고리" 
                                                                           showClearIcon = "true">
                    <core:Item key="{Category>Category}" text="{Category>Category}"/>
                    </ComboBox>
                </VBox>

                <ToolbarSpacer width = "1rem" />

                <Button text="조회" icon= "sap-icon://search" 
                        type="Emphasized"
                        press="onSearch" />

                <ToolbarSpacer width = "1rem" />

                <Button text="초기화" press="onReset"
                        icon="sap-icon://undo"
                        type="Emphasized"
                        width="80px"/>
                </HBox>
            </Panel>



        <t:Table
            id="IMenu"
            rows="{/MenuSet}"
            selectionMode="None"
            selectionBehavior="Row"
            paste="onPaste"
            ariaLabelledBy="title"
            class="sapUiResponsiveMargin">

            <t:columns>
                <t:Column width="25%">
                    <Label text="메뉴코드" />
                    <t:template>
                        <Text text="{Menuid}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="25%">
                    <Label text="메뉴명" />
                    <t:template>
                        <Text text="{Menuname}" wrapping="false" /> 
                    </t:template>
                </t:Column>

                <t:Column width="25%">
                    <Label text="카테고리" />
                    <t:template>
                        <Text text="{Category}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="25%">
                    <Label text="가격" />
                    <t:template>
                        <Text text="{
                            parts: [
                                {path: 'Price'},
                                {value: 'KRW'}
                            ],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {
                                showMeasure: true
                            }
                        }" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="25%">
                    <Label text="판매상태"/>
                    <t:template>
                        <ObjectStatus 
                              text="{Status}" 
                              state="{path: 'Status',  formatter: '.onStatusColor'}"
                              inverted="true"
                              icon="sap-icon://status-critical"/>
                    </t:template>
                </t:Column>
            </t:columns>					
        </t:Table>
    </Page>
</mvc:View>