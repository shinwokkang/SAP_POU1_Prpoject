<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Menu"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">
    <Page id="Menu_page" title="{i18n>title}" showHeader= "false">

<!-- < 메뉴 관리 테이블 /> -->
        <HBox alignItems = "Center"
              class="sapUiSmallMargin">
            <core:Icon src="sap-icon://menu"
               size="2rem"
               color="#e6bee5"
               class="sapUiResponsiveMargin"/>
               <Title text = "메뉴 관리" titleStyle="H2"/>
        </HBox>
        <HBox>
    
        <ToolbarSpacer width="80rem"/>
        <Title text="총 메뉴 수 : " width="8rem" />

        <Label
        id="TotalMenuQuantity" design="Bold" width="8rem"
        text="12"/> 

        </HBox>
        <t:Table
            id="IMenu"
            rows="{CSET>/MenuSet}"
            selectionMode="None"
            selectionBehavior="Row"
            paste="onPaste"
            ariaLabelledBy="title"
            class="sapUiResponsiveMargin">

            <t:extension>
                <OverflowToolbar style="Clear">

                    <Label text="메뉴명" design="Bold"/>
                    <Input id="IInputMenuname" class="SMALL" 
                                               width="13rem" 
                                               placeholder="메뉴명 입력" 
                                               showClearIcon = "true"/> 

                    <ToolbarSpacer width = "1rem" />   
                    
                    <Label text="카테고리" design="Bold"/>
                    <ComboBox id="ICategory" items="{path : 'Category>/'}" class="SMALL" 
                                                                           width="13rem" 
                                                                           placeholder="카테고리" 
                                                                           showClearIcon = "true">
                    <core:Item key="{Category>Category}" text="{Category>Category}"/>
                    </ComboBox>

                    <ToolbarSpacer width = "1rem" />

                    <Button text="조회" icon= "sap-icon://search" 
                                        type="Emphasized"
                                        press="onSearch" />

                    <Button text="초기화" press="onReset"
                                         icon="sap-icon://undo"
                                         type="Emphasized"
                                         width="80px"/>
                </OverflowToolbar>
            </t:extension>

            <t:columns>
                <t:Column width="25%">
                    <Label text="메뉴코드" />
                    <t:template>
                        <Text text="{CSET>Menuid}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="25%">
                    <Label text="메뉴명" />
                    <t:template>
                        <Text text="{CSET>Menuname}" wrapping="false" /> 
                    </t:template>
                </t:Column>

                <t:Column width="25%">
                    <Label text="카테고리" />
                    <t:template>
                        <Text text="{CSET>Category}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="25%">
                    <Label text="가격" />
                    <t:template>
                        <Text text="{
                            parts: [
                                {path: 'CSET>Price'},
                                {value: 'KRW'}
                            ],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {
                                showMeasure: true
                            }
                        }" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="25%">
                    <Label text="판매상태"/>
                    <t:template>
                        <ObjectStatus 
                              text="{CSET>Status}" 
                              state="{path: 'CSET>Status',  formatter: '.onStatusColor'}"
                              inverted="true"
                              icon="sap-icon://status-critical"/>
                    </t:template>
                </t:Column>
            </t:columns>					
        </t:Table>
    </Page>
</mvc:View>