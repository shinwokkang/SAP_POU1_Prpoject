<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="Dashboard_page" title="{i18n>title}" class="cafeDashboard">
       <OverflowToolbar width="100%" design="Transparent" >
    <Label text="대시보드" level="H4" design="Bold" />
    <ToolbarSpacer  />
    <!-- 달력 -->
    <HBox> 
    <Label text="조회기간"  labelFor="calender2" width="5em" design="Bold"/>
    <DatePicker id="calender2" width="10rem" placeholder="2026-11-05" displayFormat="yyyy.MM.dd"
        valueFormat="yyyy-MM-dd" press="onClcick"/>
    <DatePicker id="calender1" width="10rem" placeholder="2026-11-15" displayFormat="yyyy.MM.dd"
        valueFormat="yyyy-MM-dd" press="onClcick2"/>
    </HBox>
    <!-- 달력 끝 -->
    <!-- 막대 차트 -->

    </OverflowToolbar>
    <ToolbarSpacer  />
    <HBox>
     <VBox>
            
    </VBox>
             <core:Icon src="sap-icon://favorite" /> 
             <Text text="전체 매출" TextAlign="Center"/>
             <Title text="₩ 29,713,100" />
     <HBox>
             <core:Icon src="sap-icon://favorite" /> 
             <Text text="운영지점 수 " TextAlign="Center"/>
             <VBox>
             <Title text="12지점 " />
             </VBox>
    </HBox>
     <!-- 막대 차트 -->
   <HBox width="100%" alignItems="Stretch">

    <VBox width="50%" class="chartColumn">
        <Panel headerText="지점별 매출" width="88%" class="chartCard">
    <HBox width="100%" justifyContent="SpaceBetween" class="sapUiSmallMarginTopBottom">
    <VBox >
        <Text text="전체 매출" />
        <Title text="₩ 29,713,100" />
    </VBox>
    </HBox>
       <viz:VizFrame id="idVizFrame" height="380px" width="100%" vizType="stacked_column"
                     vizProperties="{title: {visible: true, text: '지점별 총 매출'}}">
       <viz:dataset>
              <viz.data:FlattenedDataset data="{/SalesSummarySet}">
              <viz.data:dimensions>
            <viz.data:DimensionDefinition
                    name="지점"
                    value="{Storename}" />
            </viz.data:dimensions>
            <viz.data:measures>
                <viz.data:MeasureDefinition
                    name="매출금액"
                    value="{Salesamt}" />
                </viz.data:measures>
                </viz.data:FlattenedDataset>
                </viz:dataset>
           <viz:feeds>
               <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="매출금액" />
               <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="지점" />
               <viz.feeds:FeedItem uid="color" type="Dimension" values="지점" />
               
    </viz:feeds>
    </viz:VizFrame>
    </Panel>
    </VBox>
    <!-- 막대차트 끝 -->

    <!-- 새로운 도넛 차트  -->
    <VBox width="50%" class="chartColumn" height="60px">
        <Panel
            headerText="메뉴별 매출 비중" width="95%" class="chartCard">
    <viz:VizFrame id="menuDonut" width="100%" height="380px" vizType="donut"
        vizProperties="{
            title: {
                visible: true,
                text: '메뉴별 매출 비중'
            },
            plotArea: {
                dataLabel: {
                    visible: true,
                    type: 'percentage'
                }
            },
            legend: {
                visible: true
            }
        }">

        <viz:dataset>
            <viz.data:FlattenedDataset data="{/SalesSet}">
                <viz.data:dimensions>
                    <viz.data:DimensionDefinition
                        name="메뉴"
                        value="{Menuname}" />
                </viz.data:dimensions>

                <viz.data:measures>
                    <viz.data:MeasureDefinition
                        name="매출금액"
                        value="{Amount}" />
                </viz.data:measures>
            </viz.data:FlattenedDataset>
        </viz:dataset>

        <viz:feeds>
            <viz.feeds:FeedItem uid="size" type="Measure" values="매출금액" />
            <viz.feeds:FeedItem uid="color" type="Dimension" values="메뉴" />
        </viz:feeds>
    </viz:VizFrame>
    </Panel>
    </VBox>
    </HBox>
<!-- 도넛차트 끝 -->


    </Page>
</mvc:View>