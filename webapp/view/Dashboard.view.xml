<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

        <VBox class="sapUiSmallMargin">
            <HBox alignItems = "Center" 
                class="sapUiResponsiveMargin">
                <core:Icon src="sap-icon://map-fill"
                size="2rem"
                color="#0a6ed1"
                class="sapUiSmallMarginEnd"/>
                <VBox>
                    <Title text="대시 보드" titleStyle="H3"/>
                    <Text text="전국 카페 지점 현황을 한 번에 조회하고 관리합니다"/>
                </VBox>
            </HBox>



       <OverflowToolbar width="100%" design="Transparent" >
       <HBox>
       <core:Icon src="sap-icon://bbyd-dashboard" width="2rem"/>
    <Label text="대시보드" design="Bold" />
    </HBox>
    <ToolbarSpacer  />
    <!-- 달력 -->
    <HBox alignItems="Center">
    <Label text="조회기간"  labelFor="calender2" width="5em" design="Bold"/>
    <DatePicker id="calender2" value="2026-10-30" width="10rem" displayFormat="yyyy.MM.dd" valueFormat="yyyy-MM-dd"/>

<DatePicker id="calender1" value="2026-11-03" width="10rem" displayFormat="yyyy.MM.dd" valueFormat="yyyy-MM-dd"/>
        <Button text="조회" press="Button" icon="sap-icon://search" type="Emphasized" />
    </HBox>
    <!-- 달력 끝 -->
  

    </OverflowToolbar>
   <VBox height="40px"/>

<HBox width="100%" justifyContent="SpaceBetween">

    <VBox width="24%" class="sapUiSmallMarginEnd">
       <Panel headerText="총 매출 "
          width="300px"  height="160px">
        <content>
        <VBox justifyContent="SpaceBetween">
        <VBox>
           <Title text=" 총 매출"/>
            <Text id="totalSales"/>
        </VBox>
            </VBox>
        </content>
    </Panel>
    </VBox>
    
    <VBox width="24%" class="sapUiSmallMarginEnd">
        <Panel headerText="운영지점 수 "
          width="300px"  height="160px">
        <content>
        <VBox justifyContent="SpaceBetween">
        <VBox>
           <Title text=" 운영지점 점포"/>
           <Link text="10개점" id="storeCount"
                 press = "onStore"/>
        </VBox>
            </VBox>
        </content>
    </Panel>
    </VBox>
     <VBox width="24%" class="sapUiSmallMarginEnd">
    <Panel headerText="최고 인기메뉴 "
          width="300px"  height="160px">
        <content>
        <VBox justifyContent="SpaceBetween">
        <VBox>
           <Title text=" 인기메뉴"/>
           <Text id="SaleSet"/>
        </VBox>
            </VBox>
        </content>
    </Panel>
   </VBox>
    <VBox width="24%" class="sapUiSmallMarginEnd">
     <Panel headerText="발주관리 "
          width="300px"  height="160px">
        <content>
        <VBox justifyContent="SpaceBetween">
        <VBox>
           <Title text=" 발주 관리"/>
           <Text id="orderCount"/>
        </VBox>
            </VBox>
        </content>
    </Panel>
    </VBox>

    

</HBox>
<VBox height="10px"/>
     <!-- 막대 차트 -->
<!-- 그래프 위쪽 공백 -->


<!-- 그래프 전체 -->
   <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start">
    <!-- 왼쪽 막대그래프 -->
    <VBox width="49%">
    <Panel headerText="지점별 매출" width="100%" height="430px">
    <content>
    <VBox width="100%">
       <Text text="전체 매출"/>
       <Title text="₩ 29,713,100" level="H3"/>
      <viz:VizFrame id="barChart" width="100%" height="320px" vizType="column"
    vizProperties='{
        "title": {
            "visible": true,
            "text": "총매출"
        },
        "plotArea": {
        "dataLabel": {
            "visible": true,
            "formatString": "0.0,,"
        }
    }
    }'>
       <viz:dataset>
    <viz.data:FlattenedDataset data="{/FilteredSalesSet}">
        <viz.data:dimensions>
            <viz.data:DimensionDefinition
                name="Store Name"
                value="{Storename}"/>
        </viz.data:dimensions>
        <viz.data:measures>
            <viz.data:MeasureDefinition
                name="총 매출"
                value="{Salesamt}"/>
        </viz.data:measures>
    </viz.data:FlattenedDataset>
</viz:dataset>
    <viz:feeds>
       <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="총 매출"/>
       <viz.feeds:FeedItem uid="categoryAxis" type="Dimension"  values="Store Name"/>
       </viz:feeds>
      </viz:VizFrame>
      </VBox>
       </content>
    </Panel>
        </VBox>

   
    <!-- 오른쪽 메뉴별 판매량 도넛차트 -->
    <VBox width="49%">
    <Panel headerText="메뉴별 판매량" width="100%" height="430px">
    <content>
        <viz:VizFrame id="donutChart" width="100%" height="365px" vizType="donut"
    vizProperties='{
        "title": {
            "visible": true,
            "text": "메뉴별 판매량"
        },
        "plotArea": {
            "dataLabel": {
                "visible": true,
                "type": "percentage"
            }
        }
    }'>
         <viz:dataset>
    <viz.data:FlattenedDataset data="{/FilteredMenuSet}">
        <viz.data:dimensions>
            <viz.data:DimensionDefinition
                name="Menu Name"
                value="{Menuname}"/>
        </viz.data:dimensions>
        <viz.data:measures>
            <viz.data:MeasureDefinition
                name="Quantity"
                value="{Soldqty}"/>
        </viz.data:measures>
    </viz.data:FlattenedDataset>
</viz:dataset>
                
      <viz:feeds>
             <viz.feeds:FeedItem uid="size" type="Measure" values="Quantity"/>
             <viz.feeds:FeedItem uid="color" type="Dimension" values="Menu Name"/>
      </viz:feeds>
      </viz:VizFrame>
     </content>
     </Panel>

</VBox>

</HBox>
<!-- 도넛차트 끝 -->

   

</VBox>
    </mvc:View>