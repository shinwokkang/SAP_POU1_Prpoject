<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="Dashboard_page" title="{i18n>title}" class="cafeDashboard">
       <OverflowToolbar width="100%" design="Transparent" >
       <HBox>
       <core:Icon src="sap-icon://bbyd-dashboard" width="2rem"/>
    <Label text="대시보드" design="Bold" />
    </HBox>
    <ToolbarSpacer  />
    <!-- 달력 -->
    <HBox> 
    <Label text="조회기간"  labelFor="calender2" width="5em" design="Bold"/>
    <DatePicker id="calender2" width="10rem" placeholder="2026-11-05" value="2026-11-05" displayFormat="yyyy.MM.dd"
        valueFormat="yyyy-MM-dd" />
        <Text text="~"/>
    <DatePicker id="calender1" width="10rem" placeholder="2026-11-15" value="2026-11-15" displayFormat="yyyy.MM.dd"
        valueFormat="yyyy-MM-dd"/>
        <Button text="조회" press="Button" icon="sap-icon://search" type="Emphasized" />
    </HBox>
    <!-- 달력 끝 -->
  

    </OverflowToolbar>
   <HBox width="100%" justifyContent="SpaceBetween">

    <VBox width="24%" class="sapUiSmallMarginEnd">
       <Panel headerText="총 매출 "
          width="300px"  height="160px">
        <content>
        <VBox justifyContent="SpaceBetween">
        <VBox>
           <Title text=" 총 매출"/>
            <Text id="totalSales" press="onSales"/>
        </VBox>
            </VBox>
        </content>
    </Panel>
    </VBox>
    
    <VBox width="24%" class="sapUiSmallMarginEnd">
        <Panel headerText="운영지점 수 "
          width="300px"  height="160px">
        <content>
        <VBox justifyContent="SpaceBetween">
        <VBox>
           <Title text=" 운영지점 점포"/>
           <Link text="10개점" id="storeCount"
                 press = "onStore"/>
        </VBox>
            </VBox>
        </content>
    </Panel>
    </VBox>
     <VBox width="24%" class="sapUiSmallMarginEnd">
    <Panel headerText="최고 인기메뉴 "
          width="300px"  height="160px">
        <content>
        <VBox justifyContent="SpaceBetween">
        <VBox>
           <Title text=" 인기메뉴"/>
           <Text id="SaleSet" press="SaleSet"/>
        </VBox>
            </VBox>
        </content>
    </Panel>
   </VBox>
    <VBox width="24%" class="sapUiSmallMarginEnd">
     <Panel headerText="발주관리 "
          width="300px"  height="160px">
        <content>
        <VBox justifyContent="SpaceBetween">
        <VBox>
           <Title text=" 발주 관리"/>
           <Text id="orderCount" press="onOrder"/>
        </VBox>
            </VBox>
        </content>
    </Panel>
    </VBox>

    

</HBox>
<VBox height="30px"/>
     <!-- 막대 차트 -->
<!-- 그래프 위쪽 공백 -->
<VBox height="30px"/>

<!-- 그래프 전체 -->
   <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start">
    <!-- 왼쪽 막대그래프 -->
    <VBox width="49%">
    <Panel headerText="지점별 매출" width="100%" height="430px">
    <content>
    <VBox width="100%">
       <Text text="전체 매출"/>
       <Title text="₩ 29,713,100" level="H3"/>
      <viz:VizFrame id="barChart" width="100%" height="320px" vizType="column"
    vizProperties='{
        "title": {
            "visible": true,
            "text": "총매출"
        },
        "plotArea": {
        "dataLabel": {
            "visible": true,
            "formatString": "0.0,,"
        }
    }
    }'>
       <viz:dataset>
   <viz.data:FlattenedDataset data="{/SalesSummarySet}">
    <viz.data:dimensions>
    <viz.data:DimensionDefinition name="Store Name" value="{Storename}"/>
     </viz.data:dimensions>

     <viz.data:measures>
            <viz.data:MeasureDefinition name="총 매출" value="{Salesamt}"/>
    </viz.data:measures>

    </viz.data:FlattenedDataset>
    </viz:dataset>
    <viz:feeds>
       <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="총 매출"/>
       <viz.feeds:FeedItem uid="categoryAxis" type="Dimension"  values="Store Name"/>
       </viz:feeds>
      </viz:VizFrame>
      </VBox>
       </content>
    </Panel>
        </VBox>

   
    <!-- 오른쪽 메뉴별 판매량 도넛차트 -->
    <VBox width="49%">
    <Panel headerText="메뉴별 판매량" width="100%" height="430px">
    <content>
        <viz:VizFrame id="donutChart" width="100%" height="365px" vizType="donut"
    vizProperties='{
        "title": {
            "visible": true,
            "text": "메뉴별 판매량"
        },
        "plotArea": {
            "dataLabel": {
                "visible": true,
                "type": "percentage"
            }
        }
    }'>
          <viz:dataset>
         <viz.data:FlattenedDataset data="{/MenuSet}">
        <viz.data:dimensions>
         <viz.data:DimensionDefinition name="Menu Name" value="{Menuname}"/>
            </viz.data:dimensions>
           <viz.data:measures>
            <viz.data:MeasureDefinition name="Quantity" value="{Soldqty}"/>
                        </viz.data:measures>
             </viz.data:FlattenedDataset>
                </viz:dataset>
                
      <viz:feeds>
             <viz.feeds:FeedItem uid="size" type="Measure" values="Quantity"/>
             <viz.feeds:FeedItem uid="color" type="Dimension" values="Menu Name"/>
      </viz:feeds>
      </viz:VizFrame>
     </content>
     </Panel>

</VBox>

</HBox>
<!-- 도넛차트 끝 -->
    <VBox height="45px"/>
    <!-- 큰 흰색 박스 -->
    <Panel width="100%" backgroundDesign="Solid">
    <content>
    <VBox width="100%">

                <!-- 상단 제목 -->
    <HBox width="100%" justifyContent="SpaceBetween" alignItems="Center">
         
         <Text text="매일 오전 9시 업데이트"/>
     </HBox>
     <VBox height="20px"/>
            <!-- 첫 번째 줄 -->
     <HBox width="100%" justifyContent="SpaceBetween" alignItems="Center">

    <VBox width="350px">
    <VBox >
        <Text text="영업시간 운영률 "/>
        <Title text="91%" level="H3"/>
    </VBox>
    </VBox>
     <Toolbar height="90px">
    <ToolbarSeparator/>
    </Toolbar>
     <VBox width="350px">
        <Text text="운영지점 수"/>
        <Title text="10개 지점" level="H3"/>
    </VBox>
    <Toolbar height="90px">
        <ToolbarSeparator/>
    </Toolbar>
    <VBox width="350px">
        <Text text="재고관리"/>
        <Title text="성수점 원두 부족" level="H3"/>
   </VBox>
   </HBox>
   <VBox height="15px"/>
   <VBox height="10px"/>

                <!-- 두 번째 줄 -->
    <VBox height="15px"/>
    <HBox width="100%" justifyContent="SpaceBetween">
    <Panel width="350px" height="110px">
     <content>
    <VBox>
        <Text text="최근 발주"/>
        <Title text="11월 5일 춘천점" level="H2"/>
        </VBox>
        </content>
        </Panel>

        <Panel width="350px" height="110px">
        <content>
        <VBox>
            <Text text="인기메뉴"/>
            <Title text="자몽에이드" level="H2"/>
        </VBox>
        </content>
        </Panel>
             <Panel width="350px" height="110px">
       <content>
       <VBox>
            <Text text="최근 별점 "/>
           <Title text="4.9" level="H2"/>
     </VBox>
    </content>
            </Panel>
     </HBox>
     <VBox height="20px"/>
             <!-- 아래 안내 박스 -->
    <Panel width="100%"  backgroundDesign="Translucent">
    <content>
     <HBox justifyContent="Center">
   
     </HBox>
     </content>

     </Panel>
      </VBox>
    </content>

    </Panel>

    <!-- 큰 박스와 버튼 사이 공백 -->
    <VBox height="15px"/>

   


    </Page>
    </mvc:View>