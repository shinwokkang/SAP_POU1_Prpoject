<mvc:View controllerName="code2.fiori.pou.pou1project.controller.SalesAnalytics"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns="sap.m">
        <VBox class="sapUiSmallMargin">
            <HBox alignItems = "Center"
              class="sapUiSmallMargin">
            <core:Icon src="sap-icon://business-objects-experience"
               size="2rem"
               color="#e6bee5"
               class="sapUiResponsiveMargin"/>
               <Title text = "매출 분석" titleStyle="H2"/>
            </HBox>

            <HBox alignItems="Center">
                <Label text="지점 ID" design="Bold" class="sapUiSmallMarginEnd" />
                <MultiComboBox id="storeFilter"
                               width="20rem"
                               placeholder="전체 지점"
                               items="{/SalesSummarySet}">
                    <core:Item key="{Storeid}" text="{Storename}" />
                </MultiComboBox>

                <Label text="조회기간" design="Bold" class="sapUiMediumMarginBegin sapUiSmallMarginEnd" />
                <DatePicker id="dateFrom" class="SMALL" value="2026-10-30" valueFormat="yyyy-MM-dd" displayFormat="yyyy.MM.dd" />
                <Text text="~" class="sapUiTinyMarginBeginEnd" />
                <DatePicker id="dateTo"   class="SMALL" value="2026-11-03" valueFormat="yyyy-MM-dd" displayFormat="yyyy.MM.dd" />

                <Button icon="sap-icon://search"
                        text="조회"
                        press="onSearch"
                        class="sapUiSmallMarginBegin" />
            </HBox>

            <HBox renderType="Bare" width="100%">

            <!-- 차트 : 지점별 총매출 (Column) -> 판매 내역을 지점명 기준으로 합산 -->
            <viz:VizFrame id="storeSalesChart" uiConfig="{applicationSet:'fiori'}"
                          width="50%" height="380px" vizType="column"
                          vizProperties="{
                                            title        : { visible : true, text : '지점별 총매출' },
                                            legend       : { visible : true },
                                            plotArea     : { dataLabel : { visible : true } },
                                            valueAxis    : { title : { visible : true, text : '매출액 (원)' } },
                                            categoryAxis : { title : { visible : true, text : '지점' } }
                                         }">
                <viz:dataset>
                    <viz.data:FlattenedDataset id="storeDataset" data="{/SalesSet}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="지점" value="{Storename}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="총매출" value="{Amount}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                    <viz.feeds:FeedItem uid="valueAxis"    type="Measure"   values="총매출" />
                    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="지점" />
                </viz:feeds>
            </viz:VizFrame>

            <!-- 차트 : 메뉴별 판매량 (Donut) -> 판매 내역을 메뉴명 기준으로 합산 -->
            <viz:VizFrame id="menuQtyChart" uiConfig="{applicationSet:'fiori'}"
                          width="50%" height="380px" vizType="donut"
                          vizProperties="{
                                            title    : { visible : true, text : '메뉴별 판매량' },
                                            legend   : { visible : true },
                                            plotArea : { dataLabel : { visible : true } }
                                         }">
                <viz:dataset>
                    <viz.data:FlattenedDataset id="menuDataset" data="{/SalesSet}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="메뉴" value="{Menuname}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="판매량" value="{Quantity}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                    <viz.feeds:FeedItem uid="size"  type="Measure"   values="판매량" />
                    <viz.feeds:FeedItem uid="color" type="Dimension" values="메뉴" />
                </viz:feeds>
            </viz:VizFrame>
            </HBox>
        </VBox>
</mvc:View>