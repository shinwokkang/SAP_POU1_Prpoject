    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">
    <Page id="Sales_page" showHeader="false">

        <VBox class="sapUiSmallMargin">
            <HBox   alignItems = "Center" 
                    class="sapUiResponsiveMargin">
                
                <core:Icon  src="sap-icon://sales-order"
                            size="2rem"
                            color="#0a6ed1"
                            class="sapUiSmallMarginEnd"/>
                
                <VBox>
                
                    <Title text="매출 조회" titleStyle="H3"/>
                    <Text text="전국 카페 지점의 현재 발주상태를 관리합니다"/>
                
                </VBox>
                    
                <ToolbarSpacer width="20rem"/>
                <Title text="총 판매량 : " width="5rem" />

                <Label
                id="TotalQuantity" design="Bold" width="7rem"
                text="0"/> 

                <Title text="총 매출금액 : "  width="6rem" />

                <u:Currency
                id="TotalAmount"
                value="0"
                currency="KRW"/>
            </HBox>

