<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Sales"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">
    <Page id="Sales_page" title="{i18n>title}">
            <t:Table
            id="Sales"
            rows="{Sales>/SalesSet}" 
            selectionMode="MultiToggle" 
            selectionBehavior="Row" 
            paste="onPaste"
            ariaLabelledBy="title">
            <t:extension>
                <OverflowToolbar style="Clear">
                    <Label text="날짜" design="Bold"/>
                    <Input id="IDate" width="8em" placeholder="날짜"/> 
                    <ToolbarSpacer width = "3rem" />                   
                    <Label text="지점" design="Bold"/>
                    <Input id="IStorename" width="8em" placeholder="지점"/>
                    <ToolbarSpacer width = "3rem" />
                    <Label text="메뉴" design="Bold"/>
                    <Input id="IMenuname" width="8em" placeholder="메뉴"/>

                    <Button text="Search" icon="sap-icon://search" press="onSearch"/>

                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column width="11rem">
                    <Label text="날짜" />
                    <t:template>
                        <Text text="{Sales>Salesdate}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="11rem">
                    <Label text="지점" />
                    <t:template>
                        <Text text="{Sales>Storename}" wrapping="false" /> 
                    </t:template>
                </t:Column>
                <t:Column width="11rem">
                    <Label text="메뉴" />
                    <t:template>
                        <Text text="{Sales>Menuname}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="11rem">
                    <Label text="판매량" />
                    <t:template>
                        <Text text="{Sales>Quantity}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="11rem">
                    <Label text="금액" />
                    <t:template>
		                    <u:Currency value="{Sales>Amount}" currency="{Currency}"/> 
                    </t:template>
                </t:Column>
            </t:columns>					
        </t:Table>

    </Page>
</mvc:View>