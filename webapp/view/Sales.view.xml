            <t:Table
            id="Sales"
            rows="{/SalesSet}" 
            selectionMode="None" 
            ariaLabelledBy="title"
            class="sapUiResponsiveMargin">
            <t:extension>
            <Panel class="sapUiResponsiveMargin" width="auto">
            
                <OverflowToolbar style="Clear">
                <!-- 조회기간 -->
                    <Label text="조회기간" design="Bold"/>
                    <DatePicker
					id="IStartDate" width="9rem"
					placeholder="2026-01-01" change="handleChange"
                    displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd"/>
                    <Text text="~"/>
                    <DatePicker
					id="IEndDate" width="9rem"
					placeholder="2026-12-31" change="handleChange"
                    displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd"/>
                <!-- 지점 -->
                    <ToolbarSpacer width = "3rem" />                   
                    <Label text="지점" design="Bold"/>

                    <ComboBox id="IStorename" width="8rem" placeholder="지점 선택" 
                              showClearIcon = "true" class="SMALL"
                              items="{path  : 'StoreNameSet>/StoreNameSet',
                                      sorter: {path: 'Store'}}">
                        <core:Item key="{StoreNameSet>Store}" text="{StoreNameSet>Store}"/>
                    </ComboBox>
                <!-- 메뉴 -->
                    <ToolbarSpacer width = "3rem" />
                    <Label text="메뉴" design="Bold"/>

                    <ComboBox id="IMenuname" width="8rem" placeholder="메뉴 선택" 
                              showClearIcon = "true" items="{path  : 'MenuList>/'}" class="MEDIUM">
                        <core:Item key="{MenuList>Menu}" text="{MenuList>Menu}"/>
                    </ComboBox>
                <!-- 버튼 -->
                    <Button text="조회" icon="sap-icon://search" 
                            type="Emphasized" press="onSearch"/>
                    <Button text="초기화" type="Emphasized" icon="sap-icon://undo" 
                            press="onTotal"/>  
                                
                    <ToolbarSpacer/>
                    <Button text="전체매출조회" icon="sap-icon://lead" 
                            type="Ghost" press="onTotal"/>

                </OverflowToolbar>
        
            </Panel>
            </t:extension>

            <t:columns>
                <t:Column width="20%">
                    <Label text="날짜" />
                    <t:template>
                        <Text text="{Salesdate}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="20%">
                    <Label text="지점" />
                    <t:template>
                        <Text text="{Storename}" wrapping="false" /> 
                    </t:template>
                </t:Column>
                <t:Column width="20%">
                    <Label text="메뉴" />
                    <t:template>
                        <Text text="{Menuname}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="20%">
                    <Label text="판매량" />
                    <t:template>
                        <Text text="{Quantity}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="20%">
                    <Label text="금액" />
                    <t:template>
		                    <u:Currency value="{Amount}" currency="KRW"/> 
                    </t:template>
                </t:Column>
            </t:columns>					
        </t:Table>

