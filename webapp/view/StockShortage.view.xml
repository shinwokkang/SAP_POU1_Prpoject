<mvc:View controllerName="code2.fiori.pou.pou1project.controller.StockShortage"
    xmlns:t="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
  <Page id="StockShortage_page" title="재고 부족 관리">

        <!-- ⑤ 안내 문구 + 총 건수 -->
        <MessageStrip id="shortageStrip"
                      text="최소 재고 기준 이하인 품목입니다. (총 {Shortage>/gv_count}건)"
                      type="Information"
                      showIcon="true"
                      customIcon="sap-icon://alert"
                      class="sapUiResponsiveMargin"/>

        <!-- ⑥ 부족 품목 표 -->
        <t:Table id="shortageTable"
                 rows="{Shortage>/gt_shortage}"
                 selectionMode="None"
                 class="sapUiResponsiveMargin">
            <t:columns>
                <t:Column>
                    <Label text="지점명"/>
                    <t:template>
                        <Text text="{Shortage>Storename}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column>
                    <Label text="원재료명"/>
                    <t:template>
                        <Text text="{Shortage>Matname}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column width="7rem" hAlign="End">
                    <Label text="현재 재고"/>
                    <t:template>
                        <Text text="{Shortage>Quantity}"/>
                    </t:template>
                </t:Column>

                <t:Column width="7rem" hAlign="End">
                    <Label text="최소 재고"/>
                    <t:template>
                        <Text text="{Shortage>Minqty}"/>
                    </t:template>
                </t:Column>

                <t:Column width="8rem" hAlign="Center">
                    <Label text="부족 수량"/>
                    <t:template>
                        <ObjectStatus text="{Shortage>ShortText}"
                                      state="{Shortage>State}"
                                      inverted="true"/>
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>
    </Page>
</mvc:View>