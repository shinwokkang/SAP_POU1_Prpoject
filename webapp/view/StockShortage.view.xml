<mvc:View controllerName="code2.fiori.pou.pou1project.controller.StockShortage"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

       <!-- 건수는 컨트롤러 onRowsUpdated에서 setText로 채운다 -->
        <MessageStrip id="shortageStrip"
                      text="최소 재고 기준 이하인 품목입니다."
                      type="Information"
                      showIcon="true"
                      customIcon="sap-icon://alert"
                      class="sapUiResponsiveMargin"/>

        <t:Table id="shortageTable"
                 rows="{CSET>/StockSet}"
                 rowsUpdated=".onRowsUpdated"
                 selectionMode="None"
                 class="sapUiResponsiveMargin">
                
                <t:extension>
                <OverflowToolbar style="Clear">
                    <Label text="지점" design="Bold"/>

                    <ComboBox id="IStore" width="8rem" placeholder="지점 선택" 
                              showClearIcon = "true"
                              items="{path  : 'StoreList>/',
                                      sorter: {path: 'Store'}}">
                        <core:Item key="{StoreList>Store}" text="{StoreList>Store}"/>
                    </ComboBox>

                    <Label text="원재료명" design="Bold"/>

                    <ComboBox id="IMat" width="8rem" placeholder="원재료 선택" 
                              showClearIcon = "true"
                              items="{path  : 'MatList>/',
                                      sorter: {path: 'Matname'}}">
                        <core:Item key="{MatList>Matname}" text="{MatList>Matname}"/>
                    </ComboBox>
                     <Button text="조회" icon="sap-icon://search" press="onSearch"/>
                </OverflowToolbar>
            </t:extension>

            <t:columns>
                <t:Column>
                    <Label text="지점명"/>
                    <t:template>
                        <Text text="{CSET>Storename}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column>
                    <Label text="원재료명"/>
                    <t:template>
                        <Text text="{CSET>Matname}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column width="7rem" hAlign="End">
                    <Label text="현재 재고"/>
                    <t:template>
                        <Text text="{CSET>Quantity}"/>
                    </t:template>
                </t:Column>

                <t:Column width="7rem" hAlign="End">
                    <Label text="최소 재고"/>
                    <t:template>
                        <Text text="{CSET>Minqty}"/>
                    </t:template>
                </t:Column>

                <t:Column width="8rem" hAlign="Center">
                    <Label text="부족 수량"/>
                    <t:template>
                        <ObjectStatus text="{ parts : ['CSET>Quantity', 'CSET>Minqty'], formatter : '.formatShortText' }"
                                      state="{ parts : ['CSET>Quantity', 'CSET>Minqty'], formatter : '.formatShortState' }"
                                      inverted="true"/>
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>
</mvc:View>