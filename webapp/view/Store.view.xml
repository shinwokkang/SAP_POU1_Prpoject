<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Store"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">
    <Page id="Store_page" title="{i18n>title}" showHeader="false">
        <VBox>
            <!-- 페이지 타이틀 -->
            <HBox alignItems = "Center" 
                class="sapUiResponsiveMargin">
                <core:Icon src="sap-icon://map-fill"
                size="2rem"
                color="#0a6ed1"
                class="sapUiSmallMarginEnd"/>
                <VBox>
                    <Title text="지점 관리" titleStyle="H3"/>
                    <Text text="전국 카페 지점 현황을 조회하고 관리합니다"/>
                </VBox>
            </HBox>

            <!-- 필터 : 지점명 / 지역 / 운영상태 입력 -->
            <Panel class="sapUiResponsiveMargin" width="auto">
                <HBox alignItems="End">
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="지점명" labelFor="iStorename"/>
                    <Input id="iStorename" class="SMALL" placeholder="지점명 입력" showClearIcon="true"/>
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="지역" labelFor="iRegion"/>
                    <!-- 지역 Region JSONModel 데이터를 comboBox 연결 -->
                    <ComboBox id="iRegion" class="SMALL" placeholder="지역 선택"
                            items="{path : 'Region>/'}">
                        <core:Item key="{Region>Region}" text="{Region>Region}"/>
                    </ComboBox>
                </VBox>

                <VBox class="sapUiSmallMarginEnd">
                    <Label text="운영 상태" labelFor="iStatus"/>
                    <!-- 운영상태 Status JSONModel 데이터를 comboBox 연결 -->
                    <ComboBox id="iStatus" class="SMALL" placeholder="운영 상태"
                            items="{path : 'Status>/'}">
                        <core:Item key="{Status>Status}" text="{Status>Status}"/>
                    </ComboBox>
                </VBox>

                <!-- 입력 조건으로 필터링 (onStoreSearch) -->
                <Button text="조회" icon="sap-icon://search" type="Emphasized" press="onStoreSearch"/>
                <ToolbarSpacer width = "5px"/>

                <!-- 입력값, 필터 모두 초기화 (onReset) -->
                <Button text="초기화" type="Ghost" press="onReset"/>
                </HBox>
            </Panel>

            <!-- 지점 목록 테이블 시작 -->
            <t:Table
                id = "StoreSet"
                rows="{/StoreSet}"
                selectionMode="Single"
                selectionBehavior="RowOnly"
                ariaLabelledBy="title">
                
                <t:columns>

                    <!-- 지점코드 열 -->
                    <t:Column width="11rem">
                        <Label text="지점 코드" />
                        <t:template>
                            <Text text="{Storeid}" wrapping="false" />              
                        </t:template>
                    </t:Column>

                    <!-- 지점명 열 -->
                    <t:Column width="11rem">
                        <Label text="지점명" />
                        <t:template>
                            <Text text="{Storename}" wrapping="false" />
                        </t:template>
                    </t:Column>

                    <!-- 지역 열 -->
                    <t:Column width="11rem">
                        <Label text="지역" />
                        <t:template>
                            <Text text="{Region}" wrapping="false" />
                        </t:template>
                    </t:Column>

                    <!-- 주소 열 -->
                    <t:Column width="17rem">
                        <Label text="주소" />
                        <t:template>
                            <Text text="{Address}" wrapping="false" />
                        </t:template>
                    </t:Column>

                    <!-- 담당자 열 -->
                    <t:Column width="11rem">
                        <Label text="담당자" />
                        <t:template>
                            <Text text="{Manager}" wrapping="false" />
                        </t:template>
                    </t:Column>

                    <!-- 운영상태 열 -->
                    <t:Column width="11rem">
                        <Label text="운영상태" />
                        <t:template>
                            <!-- Status 값에 따라 button type을 Accept (운영중 = 초록색 버튼) or Reject(운영중 != 빨간색 버튼)으로 할지 -->
                            <Button text = "{Status}"
                                    icon = "sap-icon://retail-store"
                                    type = "{= ${Status} === '운영중' ? 'Accept' : 'Reject' }" 
                                    press = "onStatus" />
                        </t:template>
                    </t:Column>
                    
                </t:columns>
            </t:Table>

        </VBox>

    </Page>
</mvc:View>