<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Stock"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
        <VBox class="sapUiSmallMargin">
            <HBox
                alignItems="Center"
                class="sapUiSmallMargin">

                <core:Icon
                    src="sap-icon://inventory"
                    size="2rem"
                    color="#2681cb"
                    class="sapUiResponsiveMargin"/>

                <Title
                    text="재고 관리"
                    titleStyle="H2"/>

            </HBox>
        </VBox>

        <t:Table
            id="StockSet"
            rows="{/StockSet}"
            selectionMode="None"
            ariaLabelledBy="title"
            class="sapUiResponsiveMargin" >
            
            <t:extension>
            <VBox>
                <HBox>
                <Label text="지점" design="Bold"/>
                <ComboBox 
                        id="IStore" 
                        items="{/StoreSet}"
                        class="SMALL"
                        placeholder="전체">
                    <core:Item 
                         key="{Storeid}" 
                         text="{Storename}"/>
                </ComboBox>

                <Label text="원재료명" design="Bold"/>

                <ComboBox id="IMatnr" 
                          items="{MSET>/MaterialSet}"
                          class="SMALL"
                          placeholder="전체">

                    <core:Item 
                        key="{MSET>Matnr}" 
                        text="{MSET>Matname}"/>
                </ComboBox>
                <HBox/>

                <ToolbarSpacer width="3rem"/>
                <Button
                        text="조회"
                        type="Emphasized"
                        icon="sap-icon://search"
                        press="onSearch"/>
                

                <Button 
                        text="초기화"
                        press="onReset"
                        icon="sap-icon://undo"/>
            

                </HBox>
               </VBox>
            </t:extension>

            <t:columns>
                <t:Column width="20%">
                    <Label text="지점명"/>
                    <t:template>
                        <Text text="{Storename}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column width="20%">
                    <Label text="원재료코드"/>
                    <t:template>
                        <Text text="{Matnr}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column width="20%">
                    <Label text="원재료명"/>
                    <t:template>
                        <Text text="{Matname}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column width="20%">
                    <Label text="현재재고"/>
                    <t:template>
                        <Text text="{Quantity}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column width="20%">
                    <Label text="최소재고"/>
                    <t:template>
                        <Text text="{Minqty}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column width="20%">
                    <Label text="단위"/>
                    <t:template>
                        <Text text="{Unit}" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column width="20%">
                    <Label text="재고상태"/>
                    <t:template>
                        <ObjectStatus 
                              text="{Status}" 
                              state="{path: 'Status',  formatter: '.onStatusColor'}"
                              inverted="true" 
                              icon="sap-icon://status-critical"/>
                    </t:template>
                </t:Column>

            </t:columns>
        </t:Table>

  
</mvc:View>