<mvc:View controllerName="code2.fiori.pou.pou1project.controller.Purchase"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns="sap.m">
    <VBox class="sapUiSmallMargin">
        <HBox
            alignItems="Center"
            class="sapUiSmallMargin">

            <c:Icon
                src="sap-icon://cart"
                size="2rem"
                color="#2681cb"
                class="sapUiResponsiveMargin"/>

            <Title
                text="발주 관리"
                titleStyle="H2"/>

        </HBox>
    </VBox>


    <t:Table
        id="purchaseTable"
        rows="{/PurchaseSet}"
        selectionMode="Single"
        selectionBehavior="RowOnly"
        paste="onPaste"
        ariaLabelledBy="title"
        class="sapUiResponsiveMargin">
        <t:extension>
            <VBox>
                
                <HBox>
                    <Label text = "지점명" 
                            width = "10rem" 
                            design="Bold"       />

                    <Label text = "원재료명"
                            width = "10rem" 
                            design="Bold"       />

                    <Label text = "발주상태" 
                            width = "10rem" 
                            design="Bold"       />
                        
                </HBox>
                <HBox>
                    <ComboBox
                        id="IstoreName"
                        items="{StoSet>/StoreNameSet}"
                        class="SMALL"
                        placeholder="전체">

                        <c:Item key="{StoSet>Strcd}"
                                text="{StoSet>Store}"/>
                    </ComboBox>
                    <ToolbarSpacer width="2rem" />

                    <ComboBox
                        id="ImaterialName"
                        items="{MSET>/MaterialSet}"
                        class="SMALL"
                        placeholder="전체">

                        <c:Item 
                            key="{MSET>Matnr}" 
                            text="{MSET>Matname}"/>
                    </ComboBox>
                    <ToolbarSpacer width="2rem"/>

                    <ComboBox
                        id="Istatus"
                        items="{path : 'StaSet>/'}"
                        class="SMALL"
                        placeholder="전체">

                        <c:Item 
                            key="{StaSet>Status}" 
                            text="{StaSet>Status}"/>
                    </ComboBox>
                    <ToolbarSpacer width="4rem"  />

                    <Button text="조회" icon= "sap-icon://search" press="searchPurchase" />
                    <ToolbarSpacer width="1rem"/>
                    <Button text="초기화" icon="sap-icon://undo" press="onReset"/>
                </HBox>
            </VBox>
        </t:extension>
        <t:columns>
            <t:Column width="10rem"  >
                <Label text="발주번호"/>
                <t:template>
                    <Text text="{Pono}" wrapping="false" />
                </t:template>
            </t:Column>
            
            <t:Column width="10rem">
                <Label text="지점" />
                <t:template>
                    <Text text="{Storename}" wrapping="false"/>
                </t:template>
            </t:Column>

            <t:Column width="10rem"  >
                <Label text="원재료" />
                <t:template>
                    <Text text="{Matname}" wrapping="false"/>
                </t:template>
            </t:Column>
            
            <t:Column width="10rem" hAlign="Center">
                <Label text="발주날짜"              />
                <t:template>
                    <DatePicker value="{
                        path: 'Podate',
                        type: 'sap.ui.model.type.Date',
                        formatOptions: {source: {pattern: 'yyyy-MM-dd'}}
                    }"/>
                </t:template>
            </t:Column>
            
            <t:Column width="10rem"           >
                <Label text="발주수량" />
                <t:template>
                    <Text text="{Poqty}" wrapping="false"/>
                </t:template>
            </t:Column>

            <t:Column width="10rem"           >
                <Label text="단위" />
                <t:template>
                    <Text text="{Unit}" wrapping="false"/>
                </t:template>
            </t:Column>

            <t:Column width="10rem"    >
                <Label text="발주상태" />
                <t:template>
                    <Text text="{Status}" wrapping="false"/>
                </t:template>
            </t:Column>


            <t:Column width="10rem">
                <Label text="알림상태"/>
                <t:template>
                    <ObjectStatus
                        text="{AlertStatus}"
                        state="{path:'AlertStatus', formatter:'.onAlertColor'}"
                        inverted="true"/>
                </t:template>
            </t:Column>
        </t:columns>
    </t:Table>
</mvc:View>